# ---------------------------------------------------------------
# AI Scam Shield - environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. All keys are used server-side only.
# ---------------------------------------------------------------

# === 1. SCAM MESSAGE DETECTOR (LLM / NLP) =======================
# Any OpenAI-compatible chat completions endpoint works.
# Examples:
#   OpenAI    -> https://api.openai.com/v1   model: gpt-4o-mini
#   Groq      -> https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
#   OpenRouter-> https://openrouter.ai/api/v1   model: meta-llama/llama-3.3-70b-instruct
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === 2. URL / LINK REPUTATION (optional but recommended) ========
# Google Safe Browsing v4 API key: https://developers.google.com/safe-browsing
SAFE_BROWSING_API_KEY=

# === 3. IMAGE + VIDEO FORENSICS (Google Gemini Vision or Hugging Face) ====
# Free Gemini API Key from https://aistudio.google.com/apikey (Option 2 - Recommended)
GEMINI_API_KEY=

# Alternatively: Hugging Face Token (Requires paid credits)
HF_API_TOKEN=
HF_BASE_URL=https://router.huggingface.co/hf-inference/models


# Model that detects fully AI-GENERATED / synthetic images
HF_AIGEN_IMAGE_MODEL=Organika/sdxl-detector

# Model that detects DEEPFAKE / face-manipulated images & video frames
HF_DEEPFAKE_IMAGE_MODEL=prithivMLmods/Deep-Fake-Detector-Model

# === 4. LIMITS ==================================================
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=60
VIDEO_FRAME_COUNT=8

# === 5. RATE LIMITING ===========================================
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=12

# === 6. AUTHENTICATION ==========================================
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure development secret if left empty.
AUTH_SECRET=

# === 7. NEON POSTGRESQL DATABASE ===============================
# Neon connection string
DATABASE_URL=

